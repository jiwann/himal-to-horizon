# Copy this to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (currently Neon serverless Postgres)
DATABASE_URL=

# Session cookie signing secret — any long random string
SESSION_SECRET=

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage (Google Cloud Storage) for community-post photo uploads.
# On Replit these are auto-provided by the Replit sidecar and not needed.
# Off Replit (e.g. Render), create a GCS bucket + a service account with the
# "Storage Object Admin" role on it, then set:
#   PRIVATE_OBJECT_DIR — "/<bucket-name>/<folder>", e.g. /himal-to-horizon-photos/community
#   GOOGLE_APPLICATION_CREDENTIALS_JSON — the service account's JSON key, pasted as one value
# The bucket also needs a CORS rule allowing PUT from your site, because
# browsers upload photos directly to storage.googleapis.com.
PRIVATE_OBJECT_DIR=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Flights affiliate API (Duffel)
DUFFEL_ACCESS_TOKEN=
DUFFEL_ACCESS_TOKEN_PROD=

# Affiliate tracking
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Free-tier machine translation fallback (MyMemory)
MYMEMORY_EMAIL=

# Admin panel password
ADMIN_PASSWORD=

# Error monitoring (Sentry)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Analytics
VITE_GA4_ID=
VITE_CLARITY_ID=

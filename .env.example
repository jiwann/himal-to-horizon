# Copy this to .env and fill in real values. Never commit the real .env file.

# Postgres connection string (currently Neon serverless Postgres)
DATABASE_URL=

# Session cookie signing secret — any long random string
SESSION_SECRET=

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Object storage (Google Cloud Storage) for community-post photo uploads.
# On Replit these are auto-provided by the Replit sidecar and not needed.
# Off Replit, provision a real GCS bucket + service account and set:
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Flights affiliate API (Duffel)
DUFFEL_ACCESS_TOKEN=
DUFFEL_ACCESS_TOKEN_PROD=

# Affiliate tracking
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Free-tier machine translation fallback (MyMemory)
MYMEMORY_EMAIL=

# Admin panel password
ADMIN_PASSWORD=

# Error monitoring (Sentry)
SENTRY_DSN=
VITE_SENTRY_DSN=

# Analytics
VITE_GA4_ID=
VITE_CLARITY_ID=
